#!/bin/sh
# Server hook for agentcity.al-ex.ai. Installed at /var/repo/agentcity.git/hooks/post-receive.
# The viewer is static, so deploying is a checkout: no install, no build.
set -e
TARGET=/var/www/agentcity
GIT_DIR=/var/repo/agentcity.git
BRANCH=main

while read -r oldrev newrev ref; do
  if [ "$ref" = "refs/heads/$BRANCH" ]; then
    echo "==> Deploying $BRANCH to $TARGET"
    mkdir -p "$TARGET"
    git --work-tree="$TARGET" --git-dir="$GIT_DIR" checkout -f "$BRANCH"

    # Cloudflare caches the viewer's own files for hours. Stamp each deploy's commit onto their URLs
    # so a new deploy is fetched fresh, the way hashed build output works on the other sites.
    V=$(git --git-dir="$GIT_DIR" rev-parse --short "$BRANCH")
    V="$V" perl -pi -e "s#((?:from|import) '\./[a-z]+\.js)(\?v=[^']*)?'#\1?v=\$ENV{V}'#g" "$TARGET"/viewer/*.js
    V="$V" perl -pi -e 's#((?:src|href)="\./(?:app\.js|style\.css))(\?v=[^"]*)?"#$1?v=$ENV{V}"#g' "$TARGET/viewer/index.html"
    echo "==> Deploy complete ($V)"
  fi
done
